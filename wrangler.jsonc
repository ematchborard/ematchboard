{
  // Cloudflare Workers の設定 (OpenNext アダプタ経由で Next.js を動かす)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ematchboard",
  // .open-next/worker.js(OpenNext生成のfetchハンドラ)をそのまま再exportしつつ
  // scheduled()を足したラッパー。詳細はcustom-worker.tsのコメント参照
  "main": "custom-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 「今日の全ゲーム分の試合」スナップショットをKVに書くCron(5分おき)と、
  // Worlds出場チームの直近成績(Recent form)を温めるCron(1時間おき、
  // custom-worker.tsのscheduled()がevent.cronで振り分ける)。
  // UTC基準(Cloudflareの仕様)だが間隔指定なのでJSTとのズレは影響しない
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *"]
  },
  // Cronが書くスナップショット(今日の試合・Worldsのserie/tournaments/matches)
  // 専用。それ以外の試合/チーム/大会データのキャッシュはCache API
  // (caches.default、拠点ごと)を使う — 以前はこちらもKVだったが、
  // アクセス頻度に比例して無料枠(書き込み1,000回/日)を使い切る不具合が
  // あったため2026-10-22にCache APIへ戻した(詳細はlib/edge-cache.ts参照)。
  // Cloudflareダッシュボード → Storage & Databases → KV で
  // 新規Namespaceを作成し、そのIDを id に設定すること
  "kv_namespaces": [
    {
      "binding": "MATCH_CACHE",
      "id": "1ab87e397f9b483189206a68fc2d21cf"
    }
  ],
  // ファン採点機能(ratings/comments/comment_likes)用。
  // スキーマはmigrations/配下、適用はCloudflareダッシュボードのD1コンソールから
  // (このマシンはwrangler未認証のため)。Step 1時点ではコードからまだ参照しない
  "d1_databases": [
    {
      "binding": "RATINGS_DB",
      "database_name": "ematchboard-ratings",
      "database_id": "6e3227a1-a06a-4c37-b5ff-30fdaa8e6d22"
    }
  ]
  // PANDASCORE_TOKEN・TURNSTILE_SECRET_KEY・RATINGS_PEPPER は絶対にここに
  // 書かない。Cloudflareダッシュボード(Workers & Pages → ematchboard →
  // Settings → Variables and Secrets)からSecretとして登録する
  // (ローカルプレビュー用は .dev.vars に書く)
}
