{
  // Cloudflare Workers の設定 (OpenNext アダプタ経由で Next.js を動かす)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ematchboard",
  // .open-next/worker.js(OpenNext生成のfetchハンドラ)をそのまま再exportしつつ
  // scheduled()を足したラッパー。詳細はcustom-worker.tsのコメント参照
  "main": "custom-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 「今日の全ゲーム分の試合」スナップショットをKVに書くCron(5分おき)。
  // UTC基準(Cloudflareの仕様)だが間隔指定なのでJSTとのズレは影響しない
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // 試合データの拠点間共有キャッシュ(caches.defaultは拠点ごとに別物で
  // グローバル共有ではなかったため、2026-10-11にKVへ移行)。
  // Cloudflareダッシュボード → Storage & Databases → KV で
  // 新規Namespaceを作成し、そのIDを id に設定すること
  "kv_namespaces": [
    {
      "binding": "MATCH_CACHE",
      "id": "1ab87e397f9b483189206a68fc2d21cf"
    }
  ],
  // ファン採点機能(ratings/comments/comment_likes)用。
  // スキーマはmigrations/配下、適用はCloudflareダッシュボードのD1コンソールから
  // (このマシンはwrangler未認証のため)。Step 1時点ではコードからまだ参照しない
  "d1_databases": [
    {
      "binding": "RATINGS_DB",
      "database_name": "ematchboard-ratings",
      "database_id": "6e3227a1-a06a-4c37-b5ff-30fdaa8e6d22"
    }
  ]
  // PANDASCORE_TOKEN・TURNSTILE_SECRET_KEY は絶対にここに書かない。
  // Cloudflareダッシュボード(Workers & Pages → ematchboard → Settings →
  // Variables and Secrets)からSecretとして登録する
  // (ローカルプレビュー用は .dev.vars に書く)
}
